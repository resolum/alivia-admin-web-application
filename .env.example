# Copy to .env and adjust. .env is not committed; without it the build uses these example values.

# Backend that the dev server proxies /api to (the browser never calls it directly).
API_PROXY_TARGET=http://localhost:8080

# Endpoints used by the front (relative to the site; the proxy or web server forwards them).
API_BASE_URL=/api/v1
API_AUTH_SIGN_IN_PATH=/auth/sign-in
API_AUTH_SIGN_UP_PATH=/auth/sign-up
API_AUTH_RESEND_VERIFICATION_PATH=/auth/resend-verification
API_AUTH_ACTIVATION_PATH=/auth/activation
API_AUTH_ACTIVATE_PATH=/auth/activate
API_AUTH_REFRESH_PATH=/auth/refresh
API_AUTH_LOGOUT_PATH=/auth/logout
# Not in the IAM contract yet (new_endpoints.md); agreed paths for US-16 and US-17.
API_AUTH_PASSWORD_RECOVERY_PATH=/auth/password-recovery
API_AUTH_PASSWORD_RESET_PATH=/auth/password-reset
API_USERS_PATH=/users
API_EMPLOYEES_PATH=/employees
API_CONTRACTS_PATH=/contracts
API_WORK_SCHEDULES_PATH=/work-schedules
API_STAFF_PROFILES_PATH=/staff-profiles
API_PLANS_PATH=/plans
API_HIRING_REQUESTS_PATH=/hiring-requests
